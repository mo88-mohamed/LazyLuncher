{
  "name": "launcher",
  "displayName": "Lazy Launcher Terminal Integration",
  "description": "Run Lazy Launcher project actions and custom commands inside VS Code terminals.",
  "version": "0.1.0",
  "publisher": "launchforge",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "extensionKind": ["ui"],
  "activationEvents": ["onUri", "onStartupFinished"],
  "capabilities": { "untrustedWorkspaces": { "supported": "limited", "description": "Lazy Launcher does not execute tasks until the workspace is trusted." } },
  "contributes": { "taskDefinitions": [{ "type": "launchforge", "required": ["id"], "properties": { "id": { "type": "string", "description": "Lazy Launcher action identifier" } } }] }
}
